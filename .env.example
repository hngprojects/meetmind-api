DATABASE_URL=postgresql+asyncpg://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

JWT_SECRET=your-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

RESEND_API_KEY=re_your_api_key
EMAIL_FROM=MeetMind <you@yourdomain.com>

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

CORS_ORIGINS=["http://localhost:3000"]

FRONTEND_URL=http://localhost:3000

# Redis — production: db 0, staging: db 1
REDIS_URL=redis://127.0.0.1:6379/0

# MeetMind SDK database settings. These are intentionally separate from DB_*.
SDK_DATABASE_URL=
SDK_DB_TYPE=sqlite
SDK_DB_NAME=sdk
SDK_DB_USER=
SDK_DB_PASSWORD=
SDK_DB_HOST=localhost
SDK_DB_PORT=5432
SDK_SQLITE_PATH=.sdk/sdk.sqlite
SDK_PUBLIC_BASE_URL=http://localhost:8000
SDK_TOKEN_ENCRYPTION_KEY=

# Zoom RTMS SDK prototype settings.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCESS_TOKEN=
ZOOM_OAUTH_STATE_SECRET=
ZOOM_API_BASE_URL=https://api.zoom.us/v2
ZOOM_OAUTH_TOKEN_URL=https://zoom.us/oauth/token
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/zoom/oauth/callback
ZOOM_RTMS_WEBHOOK_URL=http://localhost:8000/api/v1/zoom/rtms/webhook
ZOOM_DEFAULT_WAKE_WORDS="MeetMind,Hey MeetMind"
ZOOM_RTMS_ENABLE_AUDIO=true
ZOOM_RTMS_ENABLE_TRANSCRIPT=true
